# ============================================================
#  ROOT / SERVER ENVIRONMENT VARIABLES
#  Copy this file to server/.env and fill in real values.
# ============================================================

# --- Database (PostgreSQL) ---------------------------------
# Local install, Docker (see docker-compose.yml), Supabase, or Railway.
# Example Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_app?schema=public"

# --- API server ---------------------------------------------
PORT=5000
NODE_ENV=development

# --- Auth ---------------------------------------------------
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# --- CORS (frontend origin) ---------------------------------
CLIENT_URL="http://localhost:3000"

# --- Email/SMS (optional placeholders for receipts) ---------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=

# --- Client (Next.js) ---------------------------------------
# NEXT_PUBLIC_API_URL must point at the Express API.
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
